# Copy to backend/.env and fill in. Without a .env the backend runs on a local H2 file database.
# Supabase dashboard -> Connect -> "Session pooler" (port 5432). Prefix the URI with jdbc: and drop user:password from it.
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your-database-password
# Any random string of 32+ characters; signs login tokens.
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
# Where the frontend is served from (comma separated)
CORS_ORIGINS=http://localhost:5173
